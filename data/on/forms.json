    {
      "id": "2229E",
      "form_name": "Residential Tenancy Agreement (Standard Form of Lease)",
      "status": "active",
      "category": "general",
      "matter_type": "agreement",
      "current_version": "December 2020",
      "official_url": "https://forms.mgcs.gov.on.ca/dataset/edff7620-980b-455f-9666-643196d8312f/resource/05677ea2-3173-4c0e-9a14-7a06cbcb41b9/download/2229e_standard-lease_static.pdf",
      "official_index_url": "https://forms.mgcs.gov.on.ca/en/dataset/047-2229",
      "initiating_party": "landlord",
      "parties": [
        "landlord",
        "tenant"
      ],
      "property_manager_role": "May prepare the lease and be named as contact in section 3, but the landlord's legal name goes in section 1 and the landlord (or an authorized signatory) signs.",
      "use_when": "Starting a private residential tenancy in Ontario on or after April 30, 2018 that is not exempt from the standard lease requirement.",
      "do_not_use_when": [
        "The tenancy is exempt: care homes, sites in mobile home parks and land lease communities, most social and supportive housing, co-operative housing, or a tenancy where the tenant shares a kitchen or bathroom with the owner or the owner's family.",
        "The tenancy began before April 30, 2018 and neither party has requested the standard lease."
      ],
      "related_forms": [],
      "legal_effect": "Sets the terms of the tenancy. Sections 1 to 17 are mandatory and cannot be changed; additional terms in an attachment cannot take away a right or responsibility under the Residential Tenancies Act, 2006.",
      "source_basis": [
        "The catalogued PDF is the static variant (2229E 2020/12): 14 pages with AcroForm fields, fillable without XFA support. The default download on the dataset page is a dynamic XFA form that renders a single placeholder page in readers without XFA."
      ],
      "last_verified": "2026-09-26"
