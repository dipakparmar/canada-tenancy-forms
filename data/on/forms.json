  "operational_rules": {
    "landlord_vs_property_manager": {
      "landlord": "The owner or legal entity that is the landlord under the tenancy agreement. The landlord remains responsible for statutory obligations even when an agent performs administrative tasks.",
      "property_manager_or_authorized_agent": "A person or company authorized to act for the landlord. The manager may complete, sign, serve, receive, file, or respond to forms only within the authority granted by the landlord and the applicable form or process.",
      "tenant": "The person or persons named as tenant(s) under the tenancy agreement. A tenant signs tenant-originated forms and receives landlord notices.",
      "practical_rule": "Identify the legal landlord in section 1 of the standard lease and put an agent's contact details in section 3 where the form permits. Keep written proof of agency authority."
    },
    "document_controls": [
      "Record the form ID, version date, completion date, service date, serving person, recipient, service method, and proof of service.",
      "Use the official Board form rather than reproducing a private form when the Board requires a prescribed form.",
      "Give the tenant a copy of the signed standard lease within 21 days of signing; the tenant's remedies under the Act depend on it.",
      "Keep the signed lease, any attachment of additional terms, every notice served, proof of service, and the rent ledger together for any later application."
    ]
  },
